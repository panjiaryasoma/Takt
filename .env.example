APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Optional provider-backed extraction/explanation.
# Keep providers behind adapters. Never commit secrets.
LLM_PROVIDER=
LLM_API_KEY=

# RevenueCat is mobile-owned.
# Use apps/mobile/config/*.local.json with --dart-define-from-file.
# Do not add RevenueCat SDK or secret keys to this root backend env file.
